{
  "schema_version": "1.0",
  "id": "HTML-012",
  "mechanism": "External navigation requires explicit security review.",
  "tasks": [
    "navigation",
    "security"
  ],
  "detector": {
    "type": "existing_static_audit",
    "rule_id": "HTML-012"
  },
  "evidence": {
    "kind": "source_pattern",
    "limitation": "A source pattern alone does not prove a user-task failure or WCAG nonconformance."
  },
  "decision": {
    "detected": "SOURCE_PATTERN_OR_CANDIDATE",
    "not_detected": "NO_PATTERN_OBSERVED",
    "runtime_claim_allowed": false
  },
  "remediation": {
    "policy": "Propose the smallest task-preserving change; require human confirmation before editing."
  },
  "verification": {
    "method": "repeat_same_static_case_then_task_browser_contract_if_applicable"
  },
  "cases": [
    {
      "name": "trigger",
      "extension": "html",
      "source": "<a href=\"https://example.org\" target=\"_blank\">Go</a>",
      "expect_detected": true
    },
    {
      "name": "counterexample",
      "extension": "html",
      "source": "<a href=\"https://example.org\" target=\"_blank\" rel=\"noopener\">Go</a>",
      "expect_detected": false
    },
    {
      "name": "boundary",
      "extension": "html",
      "source": "<a href=\"https://example.org\" target=\"_self\">Go</a>",
      "expect_detected": false
    }
  ]
}
