{
  "schema_version": "1.0",
  "id": "JS-004",
  "mechanism": "Users must retain control of content magnification.",
  "tasks": [
    "mobile",
    "accessibility"
  ],
  "detector": {
    "type": "existing_static_audit",
    "rule_id": "JS-004"
  },
  "evidence": {
    "kind": "source_pattern",
    "limitation": "A source pattern alone does not prove a user-task failure or WCAG nonconformance."
  },
  "decision": {
    "detected": "SOURCE_PATTERN_OR_CANDIDATE",
    "not_detected": "NO_PATTERN_OBSERVED",
    "runtime_claim_allowed": false
  },
  "remediation": {
    "policy": "Propose the smallest task-preserving change; require human confirmation before editing."
  },
  "verification": {
    "method": "repeat_same_static_case_then_task_browser_contract_if_applicable"
  },
  "cases": [
    {
      "name": "trigger",
      "extension": "js",
      "source": "const viewport = \"<meta name=\\\"viewport\\\" content=\\\"width=device-width, user-scalable=no\\\">\";",
      "expect_detected": true
    },
    {
      "name": "counterexample",
      "extension": "js",
      "source": "const viewport = \"<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\">\";",
      "expect_detected": false
    },
    {
      "name": "boundary",
      "extension": "js",
      "source": "const viewport = \"<meta name=\\\"viewport\\\" content=\\\"maximum-scale=1\\\">\";",
      "expect_detected": true
    }
  ]
}
