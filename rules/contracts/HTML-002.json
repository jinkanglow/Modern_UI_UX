      "expect_detected": true
    },
    {
      "name": "counterexample",
      "extension": "html",
      "source": "<html lang=\"en\"><body>Hi</body></html>",
      "expect_detected": false
    },
    {
      "name": "boundary",
      "extension": "html",
      "source": "<html lang=\"\"><body>Hi</body></html>",
      "expect_detected": false
    }
  ]
