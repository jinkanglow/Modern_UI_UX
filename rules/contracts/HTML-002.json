{
  "schema_version": "1.0",
  "id": "HTML-002",
  "mechanism": "Assistive technologies require a language context.",
  "tasks": [
    "content",
    "accessibility"
  ],
  "detector": {
    "type": "existing_static_audit",
    "rule_id": "HTML-002"
  },
  "evidence": {
    "kind": "source_pattern",
    "limitation": "A source pattern alone does not prove a user-task failure or WCAG nonconformance."
  },
  "decision": {
    "detected": "SOURCE_PATTERN_OR_CANDIDATE",
    "not_detected": "NO_PATTERN_OBSERVED",
